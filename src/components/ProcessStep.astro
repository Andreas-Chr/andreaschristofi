---
import ButtonAccordion from './ButtonAccordion.astro';
import phases from '../data/process.json';
interface Props { id?: string; }
const { id = 'phase' } = Astro.props;
---
  <div class="phase-cards" data-process-step>
    {phases.map((phase,i)=><article data-accordion-card class="phase-card" data-phase={i}>
      <span class="phase-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>
      <h3><ButtonAccordion indicatorClass="phase-toggle" type="button" class="phase-trigger" disabled aria-expanded="true" aria-controls={`${id}-panel-${i}`}><span>{phase.title}</span></ButtonAccordion></h3>
      <div id={`${id}-panel-${i}`} class="phase-panel"><p class="phase-subtitle">{phase.subtitle}</p><p>{phase.description}</p></div>
    </article>)}
  </div>
<script>
  import { setPanel, resizeCards } from '../scripts/disclosure';
  document.querySelectorAll<HTMLElement>('[data-process-step]').forEach(root=>{
    if(root.dataset.ready) return;
    const process=root.closest<HTMLElement>('[data-process]');
    const cards=Array.from(root.querySelectorAll<HTMLElement>('[data-phase]'));
    let active=0;
    let selection=0;
    const select=(index:number,animate=true)=>{
      const revision=++selection;
      const deferReveal=animate && !matchMedia('(prefers-reduced-motion: reduce)').matches;
      active=index; root.dataset.phase=String(active);
      if(process) process.dataset.phase=String(active);
      root.style.setProperty('--phase-columns',cards.map((_,i)=>i===active?'minmax(0,calc(100% - 732px))':'minmax(0,240px)').join(' '));
      resizeCards(cards,()=>cards.forEach((card,i)=>{
        const open=i===active;
        card.dataset.active=String(open);
        const button=card.querySelector<HTMLButtonElement>('button')!;
        const panel=card.querySelector<HTMLElement>('.phase-panel')!;
        panel.toggleAttribute('data-reveal-pending',open&&deferReveal);
        setPanel(panel,button,open,false);
      }),animate);
      if(deferReveal) {
        // Wait for the actual layout animations, including interrupted transitions.
        const animations=[...root.getAnimations(),...cards.flatMap(card=>card.getAnimations())];
        Promise.allSettled(animations.map(animation=>animation.finished)).then(()=>{
          if(revision!==selection) return;
          const card=cards[index];
          const panel=card.querySelector<HTMLElement>('.phase-panel')!;
          panel.removeAttribute('data-reveal-pending');
          setPanel(panel,card.querySelector<HTMLButtonElement>('button')!,true,true);
        });
      }
    };
    cards.forEach((card,i)=>{
      const trigger=card.querySelector<HTMLButtonElement>('button')!;
      trigger.addEventListener('click',()=>{if(active!==i)select(i);});
      trigger.disabled=false;
    });
    root.dataset.ready='true';select(0,false);
  });
</script>
<style>
  .phase-cards { display:grid; gap:4px; }
  .phase-card { position:relative; min-width:0; padding:24px 64px 24px 24px; border-radius:24px; background:var(--color-surface-card-light); color:var(--color-text-dark); transition:background var(--primitive-animation-duration-standard),color var(--primitive-animation-duration-standard); }
  .phase-number { display:block; font:400 12px/16px var(--font-family-primary); margin-bottom:16px; }
  /* Keep the section typography above ButtonAccordion's reset in every CSS bundle order. */
  .phase-cards .phase-trigger { font:900 24px/36px var(--font-family-primary); text-transform:uppercase; color:inherit; border:0; background:none; padding:0; text-align:left; }
  .phase-trigger::after { content:''; position:absolute; inset:0; border-radius:inherit; }
  .phase-trigger:focus-visible { outline:none; }
  .phase-card:has(:focus-visible) { outline:3px solid #c5fa00; outline-offset:4px; }
  .phase-card[data-active='true']:has(:focus-visible) { outline-color:#4b09f5; }
  .phase-panel { margin-top:16px; font-size:16px; line-height:32px; }
  .phase-panel[data-reveal-pending] { visibility:hidden; }
  .phase-subtitle { font:500 20px/36px var(--font-family-secondary); margin-bottom:16px; }
  .phase-cards :global(.phase-toggle) { display:none; position:absolute; right:24px; top:50%; transform:translateY(-50%); }
  [data-ready] :global(.phase-toggle) { display:flex; }
  [data-active='false'] { background:var(--color-surface-card-dark); color:var(--color-text-light); }

  @media(max-width:399px) { .phase-card[data-active='true'], .phase-card:not([data-active]) { padding-right:72px; } }
  @media(min-width:1200px) {
    .phase-cards { grid-template-columns:var(--phase-columns,repeat(4,minmax(0,1fr))); transition:grid-template-columns var(--primitive-animation-duration-standard) var(--primitive-animation-easing-standard); }
    .phase-card { padding:24px 24px 80px; min-height:600px; }
    /* Wrapped text must not affect row height while the card is still narrow. */
    .phase-panel[data-reveal-pending] { display:none; }
    .phase-cards :global(.phase-toggle) { top:auto; bottom:24px; left:24px; transform:none; }
  }
</style>
