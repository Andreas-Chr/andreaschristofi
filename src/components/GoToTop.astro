---
import ButtonIcon from './ButtonIcon.astro';
---

<ButtonIcon
  class="go-to-top"
  version="tertiary"
  href="#page-top"
  aria-label="Go to top"
  icon="/assets/icons/go-to-top.svg"
  data-go-to-top
  hidden
/>

<style>
  :global(.go-to-top) {
    position:fixed;
    right:calc(20px + env(safe-area-inset-right, 0px));
    bottom:calc(20px + env(safe-area-inset-bottom, 0px));
    z-index:50;
  }
  :global(.go-to-top[hidden]) { display:none; }
</style>

<script>
  const link = document.querySelector<HTMLAnchorElement>('[data-go-to-top]');
  if (link) {
    const topRegion = document.querySelector<HTMLElement>('.top-region');
    const updateVisibility = () => {
      const heroBottom = topRegion ? topRegion.getBoundingClientRect().bottom + window.scrollY : 0;
      link.hidden = window.scrollY < Math.max(window.innerHeight, heroBottom);
    };
    let frame = 0;
    const scheduleUpdate = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        updateVisibility();
      });
    };
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('pageshow', scheduleUpdate);
    if (topRegion) new ResizeObserver(scheduleUpdate).observe(topRegion);
    updateVisibility();
  }
  link?.addEventListener('click', (event) => {
    // Preserve native link behavior for modified clicks.
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    document.getElementById('page-top')?.focus({ preventScroll: true });
    window.scrollTo({
      top: 0,
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
    });
  });
</script>
