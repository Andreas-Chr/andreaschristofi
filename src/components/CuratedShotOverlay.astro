---
import ButtonIcon from './ButtonIcon.astro';
import ParagraphLink from './ParagraphLink.astro';
import CuratedShotCard from './CuratedShotCard.astro';
import CuratedShotMedia from './CuratedShotMedia.astro';
import { shotMedia, shotTitle, type CuratedShot } from '../lib/curated-shots';
import { richTextHTML } from '../lib/rich-text';
import { site } from '../data/site';
interface Props { shots: CuratedShot[]; }
const { shots } = Astro.props;
---
<dialog id="curated-shot-overlay" class="shot-overlay" aria-labelledby="active-shot-title" data-shot-dialog>
  <div class="shot-close-bar">
    <ButtonIcon version="secondary" size="small" aria-label="Close curated shot" data-shot-close>
      <img class="shot-close-icon" src="/assets/icons/curated-shot-close.svg" width="12" height="16" alt="" />
    </ButtonIcon>
  </div>
  <div class="shot-panel" data-shot-scroll>
    <div class="shot-container" data-shot-content></div>
  </div>
</dialog>
{shots.map((shot, index) => {
  const [firstMedia, ...remainingMedia] = shotMedia(shot);
  const overview = richTextHTML(shot.overview);
  const related = [...shots.slice(index + 1), ...shots.slice(0, index)].slice(0, 2);
  return <template data-shot-template={shot.slug}>
    <article class="shot-article" data-shot={shot.slug}>
      <div class="shot-body">
        <header class="shot-header">
          <h2 id="active-shot-title" tabindex="-1">{shotTitle(shot)}</h2>
          {firstMedia && <CuratedShotMedia media={firstMedia} title={shotTitle(shot)} priority />}
          {overview && <div class="shot-rich-text" data-shot-overview set:html={overview} />}
          {richTextHTML(firstMedia?.description) && <div class="shot-rich-text" data-shot-description set:html={richTextHTML(firstMedia?.description)} />}
        </header>
        {remainingMedia.length > 0 && <div class="shot-media-list">
          {remainingMedia.map(item => <div class="shot-media-block">
            <CuratedShotMedia media={item} title={shotTitle(shot)} />
            {richTextHTML(item.description) && <div class="shot-rich-text" data-shot-description set:html={richTextHTML(item.description)} />}
          </div>)}
        </div>}
      </div>
      {related.length > 0 && <section class="shot-related" aria-label="Other curated shots">
        <h3>Other Curated Shots</h3>
        <div class="shot-related-grid">{related.map(other => <CuratedShotCard shot={other} layout="caption" sizes="(min-width: 1024px) 494px, (min-width: 644px) calc((100vw - 36px) / 2), calc(100vw - 16px)" />)}</div>
      </section>}
      <footer class="shot-contact">
        <h3>Get in touch</h3>
        <p>Submit a request to <ParagraphLink mode="dark" href={`mailto:${site.email}`}>{site.email}</ParagraphLink>. We’ll discuss your project and propose a solution.</p>
      </footer>
    </article>
  </template>;
})}
<script>
  import { initCuratedShots } from '../scripts/curated-shots';
  initCuratedShots();
  document.addEventListener('astro:page-load', initCuratedShots);
</script>
<style>
  .shot-overlay { position:fixed; inset:25px 0 auto; display:flex; flex-direction:column; gap:16px; margin:0 auto; padding:0; width:100%; max-width:1440px; max-height:calc(100dvh - 25px); border:0; background:transparent; color:var(--color-text-dark); overflow:visible; }
  .shot-overlay:not([open]) { display:none; }
  .shot-overlay::backdrop { background:rgb(0 0 0 / 60%); }
  @media(prefers-reduced-motion:no-preference) {
    .shot-overlay[open] { animation:shot-enter var(--primitive-animation-duration-slow) var(--primitive-animation-easing-standard) both; }
    .shot-overlay[open]::backdrop { animation:shot-backdrop-enter var(--primitive-animation-duration-standard) ease-out both; }
    .shot-overlay[open][data-motion='closing'] { animation:shot-exit var(--primitive-animation-duration-standard) ease-in both; }
    .shot-overlay[open][data-motion='closing']::backdrop { animation:shot-backdrop-exit var(--primitive-animation-duration-standard) ease-in both; }
  }
  @keyframes shot-enter {
    from { opacity:0; transform:translateY(24px); }
    to { opacity:1; transform:translateY(0); }
  }
  @keyframes shot-exit {
    from { opacity:var(--shot-exit-opacity,1); transform:var(--shot-exit-transform,translateY(0)); }
    to { opacity:0; transform:translateY(16px); }
  }
  @keyframes shot-backdrop-enter { from { opacity:0; } to { opacity:1; } }
  @keyframes shot-backdrop-exit { from { opacity:1; } to { opacity:0; } }
  .shot-close-bar { display:flex; justify-content:flex-end; flex-shrink:0; padding:0 20px; }
  .shot-close-bar .shot-close-icon { width:12px; height:16px; }
  .shot-panel { width:100%; min-height:0; padding-block:24px; border-radius:24px 24px 0 0; background:var(--color-surface-card-light,#fff); overflow:auto; overscroll-behavior:contain; }
  .shot-container { width:100%; max-width:1024px; margin-inline:auto; padding-inline:16px; }
  .shot-article { display:flex; flex-direction:column; gap:40px; }
  .shot-body,.shot-header,.shot-media-list,.shot-media-block { display:flex; flex-direction:column; gap:24px; min-width:0; }
  .shot-body h2,.shot-contact h3 { font:var(--text-headings-h4); text-transform:none; overflow-wrap:anywhere; }
  .shot-body h2 { outline:none; }
  .shot-body :global(.shot-rich-text) { display:flex; flex-direction:column; gap:16px; font:var(--text-body-medium); font-variation-settings:'opsz' 9; overflow-wrap:anywhere; }
  .shot-body :global(.shot-rich-text p) { white-space:pre-line; }
  .shot-body :global(.shot-rich-text :is(h2,h3,h4,h5,h6)) { margin:0; }
  .shot-body :global(.shot-rich-text a) { color:inherit; text-decoration:underline; text-underline-offset:3px; }
  .shot-body :global(.shot-rich-text ul),.shot-body :global(.shot-rich-text ol) { padding-left:1.5em; }
  .shot-related,.shot-contact { display:flex; flex-direction:column; gap:24px; padding-block:40px; }
  .shot-related h3 { font:900 24px/36px var(--font-family-primary); text-transform:uppercase; overflow-wrap:anywhere; }
  .shot-related-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); align-items:start; gap:4px; }
  .shot-related-grid :global(.curated-card-title) { color:var(--color-text-dark); }
  .shot-related-grid :global(.curated-card-media) { aspect-ratio:694/521; }
  .shot-related-grid :global(.curated-card-caption .curated-card-title) { font:var(--text-headings-h3); }
  .shot-related-grid :global(.curated-card:focus-visible) { outline-color:var(--color-focus-secondary); }
  .shot-contact p { font:var(--text-display-small); font-variation-settings:'opsz' 14; overflow-wrap:anywhere; }
  @media(max-width:1023px) { .shot-body :global(.shot-media) { border-radius:16px; } }
  @media(max-width:643px) {
    .shot-container { padding-inline:8px; }
    .shot-related-grid { grid-template-columns:minmax(0,1fr); }
    .shot-body :global(.shot-media) { border-radius:8px; }
  }
</style>
