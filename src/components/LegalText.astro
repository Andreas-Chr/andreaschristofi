---
interface Props { text:string; size?:number; segments?:{text:string;list:string}[]; }
const {text,size=16,segments=[{text,list:'NONE'}]}=Astro.props;
let offset=0;
const ranges=segments.map(s=>{const start=offset;offset+=s.text.length;return {...s,start,end:offset};});
const blocks:{list:string;lines:string[]}[]=[];
offset=0;
for(const line of text.split('\n')) {
  const list=ranges.find(s=>offset>=s.start&&offset<s.end)?.list||'NONE';
  offset+=line.length+1;
  if(!line.trim()){blocks.push({list:'SPACE',lines:[]});continue;}
  const previous=blocks[blocks.length-1];
  if(previous?.list===list)previous.lines.push(line);
  else blocks.push({list,lines:[line]});
}
const pattern=/(https:\/\/www\.gov\.cy\/dataprotection\/|developers\.cloudflare\.com\/fundamentals\/reference\/policies-compliances\/cloudflare-cookies|cloudflare\.com\/privacypolicy|namecheap\.com\/legal\/general\/privacy-policy|hello@andreaschristofi\.com|andreaschristofi\.com)/g;
function parts(line:string) {
  return line.split(pattern).map(value=>({value,href:value==='hello@andreaschristofi.com'?`mailto:${value}`: /^(https:|cloudflare\.com\/|developers\.cloudflare\.com\/|namecheap\.com\/|andreaschristofi\.com$)/.test(value) ? (value.startsWith('https:')?value:`https://${value}`):undefined}));
}
---
<div class:list={['legal-block',{'lead-copy':size===20}]}>
  {blocks.map(block=>block.list==='SPACE'?<div class="paragraph-space" aria-hidden="true" />:block.list==='UNORDERED'||block.list==='ORDERED'?<ul>{block.lines.map(line=><li>{parts(line).map(part=>part.href?<a href={part.href} target={part.href.startsWith('mailto:')?undefined:'_blank'} rel={part.href.startsWith('mailto:')?undefined:'noopener noreferrer'}>{part.value}</a>:part.value)}</li>)}</ul>:<p>{block.lines.map((line,i)=><Fragment>{i>0&&<br />}{parts(line).map(part=>part.href?<a href={part.href} target={part.href.startsWith('mailto:')?undefined:'_blank'} rel={part.href.startsWith('mailto:')?undefined:'noopener noreferrer'}>{part.value}</a>:part.value)}</Fragment>)}</p>)}
</div>
<style>
  p,ul { margin:0; } ul { padding-left:24px; } .paragraph-space { height:32px; }
  .lead-copy { font-size:20px; line-height:36px; font-weight:500; }
  a { overflow-wrap:anywhere; } a:hover { color:var(--color-text-accent); }
</style>
