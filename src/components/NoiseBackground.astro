---
import Noise from './vendor/Noise.jsx';
interface Props { fixed?: boolean; }
const { fixed = false } = Astro.props;
---
<div class:list={['noise-background', { fixed }]} aria-hidden="true">
  <Noise client:idle patternSize={50} patternScaleX={1} patternScaleY={1} patternRefreshInterval={2} patternAlpha={10} />
</div>
<style>
  .noise-background { position:absolute; inset:0; z-index:1; overflow:hidden; pointer-events:none; }
  .noise-background.fixed { position:fixed; z-index:-1; }
  .noise-background :global(astro-island) { display:block; width:100%; height:100%; }
</style>
