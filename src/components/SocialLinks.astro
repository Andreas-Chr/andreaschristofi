---
import { socialLinks } from '../data/site';
interface Props { surface?: 'dark'|'light'; menu?: boolean; compact?: boolean; }
const { surface='dark', menu=false,compact=false }=Astro.props;
const links=menu ? [socialLinks[0],socialLinks[2],socialLinks[1]] : socialLinks;
---
<ul class:list={["social-links",surface,{compact}]} aria-label="Social profiles">
  {links.map(link => <li><a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`Andreas Christofi on ${link.label}`}><img src={`/assets/icons/${link.icon}.svg`} width="16" height="16" alt="" /></a></li>)}
</ul>
<style>
  .social-links { display:flex; flex-wrap:wrap; gap:4px; list-style:none; padding:0; margin:0; }
  a { display:flex; align-items:center; justify-content:center; width:48px; height:48px; background:var(--color-button-tertiary-default); border-radius:8px; transition:background var(--primitive-animation-duration-fast); }
  a:hover { background:var(--color-button-primary-hover); }
  .dark img { filter:brightness(0) invert(1); }
  .light a { background:#fff; border:1px solid #e3e3e3; }
  .light a:hover { background:#4b09f5; }
  a:hover img { filter:brightness(0) invert(1); }
  img { width:16px; height:16px; }
  @media(max-width:639px) { .compact a { width:32px; height:32px; border-radius:4px; } }
</style>
