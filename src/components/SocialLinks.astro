---
import ButtonIcon from './ButtonIcon.astro';
import { socialLinks } from '../data/site';
interface Props { surface?: 'dark'|'light'; menu?: boolean; compact?: boolean; }
const { surface='dark', menu=false,compact=false }=Astro.props;
const links=menu ? [socialLinks[0],socialLinks[2],socialLinks[1]] : socialLinks;
---
<ul class:list={["social-links",surface,{compact}]} aria-label="Social profiles">
  {links.map(link => <li><ButtonIcon version={surface === 'light' ? 'secondary' : 'tertiary'} compact={compact} icon={`/assets/icons/${link.icon}.svg`} href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`Andreas Christofi on ${link.label}`} /></li>)}
</ul>
<style>
  .social-links { display:flex; flex-wrap:wrap; gap:4px; list-style:none; padding:0; margin:0; }
</style>
