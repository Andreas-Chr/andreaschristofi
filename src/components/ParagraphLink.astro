---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'a'> { disabled?: boolean; }
const { disabled=false, class:className, href, ...attributes }=Astro.props;
---
{disabled ? <span class:list={['paragraph-link',className]} role="link" aria-disabled="true"><slot /></span> : <a {...attributes} class:list={['paragraph-link',className]} href={href}><slot /></a>}
<style>
  .paragraph-link { color:inherit; font-weight:500; text-decoration:underline; text-decoration-thickness:from-font; text-decoration-skip-ink:none; text-underline-position:from-font; text-underline-offset:auto; overflow-wrap:anywhere; transition:color var(--primitive-animation-duration-fast) var(--primitive-animation-easing-fast); }
  a.paragraph-link:hover,a.paragraph-link:active { color:var(--color-text-hover); }
  a.paragraph-link:focus-visible { outline:3px solid currentColor; outline-offset:5px; }
  .paragraph-link[aria-disabled='true'] { color:var(--color-text-disabled); cursor:default; }
</style>
