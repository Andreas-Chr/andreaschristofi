---
import { navigation, site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
---
<header class="site-header" data-menu>
  <div class="header-row container">
    <a class="logo-link" href="/" aria-label="Andreas Christofi — Home">
      <img class="full-logo" src="/assets/logo/header-logo.svg" width="249" height="84" alt="" />
      <span class="small-logo">
        <img src="/assets/logo/logo-light.svg" width="27" height="48" alt="" />
      </span>
    </a>
    <button class="icon-button menu-trigger" type="button" aria-label="Open main menu" aria-expanded="true" aria-controls="main-navigation" hidden>
      <img src="/assets/icons/burger.svg" width="24" height="24" alt="" />
    </button>
  </div>
  <div class="menu-panel" id="main-navigation">
    <button class="icon-button menu-close" type="button" aria-label="Close menu" hidden>
      <img src="/assets/icons/close.svg" width="24" height="24" alt="" />
    </button>
    <nav aria-label="Main navigation">
      <ul>
        {navigation.map(link=><li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
    <div class="menu-contact">
      <h2>Get in touch</h2>
      <p>Submit a request to <a href={`mailto:${site.email}`}>{site.email}</a>. We’ll discuss your project and propose a solution.</p>
    </div>
    <div>
      <p class="eyebrow">Follow me</p>
      <SocialLinks />
    </div>
  </div>
</header>
<script>
  import { setPanel } from '../scripts/disclosure';
  const root = document.querySelector<HTMLElement>('[data-menu]');
  if (root && !root.dataset.ready) {
    const trigger = root.querySelector<HTMLButtonElement>('.menu-trigger')!;
    const close = root.querySelector<HTMLButtonElement>('.menu-close')!;
    const panel = root.querySelector<HTMLElement>('.menu-panel')!;
    const change = (open: boolean, restore = false) => {
      if (restore) trigger.focus({ preventScroll: true });
      setPanel(panel, trigger, open);
      trigger.setAttribute('aria-label', open ? 'Toggle main menu' : 'Open main menu');
    };
    trigger.addEventListener('click', () => change(trigger.getAttribute('aria-expanded') !== 'true'));
    close.addEventListener('click', () => change(false, true));
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') change(false, true); });
    document.addEventListener('click', event => { if (!root.contains(event.target as Node) && trigger.getAttribute('aria-expanded') === 'true') change(false); });
    panel.querySelectorAll('a').forEach(link => link.addEventListener('click', () => change(false)));
    setPanel(panel, trigger, false, false);
    root.dataset.ready = 'true';
    trigger.hidden = close.hidden = false;
  }
</script>
<style>
  .site-header { position:relative; z-index:100; padding-block:var(--header-padding); }
  .site-header[data-ready] { position:fixed; inset:0 0 auto; pointer-events:none; backdrop-filter:blur(5px); filter:drop-shadow(0 2px 5px #00000012); border-radius:1rem; }
  .header-row { display:flex; justify-content:center; gap:1rem; align-content:center; align-items:center; flex-direction:row; flex-wrap:wrap; }
  .header-row>* { pointer-events:auto; }
  .logo-link { width:14.93rem; height:4rem; display:block; position:relative; }
  .full-logo { position:absolute; width:15.56rem; height:5.25rem; max-width:none; left:-.625rem; top:-.5rem; }
  .small-logo { display:none; width:3rem; height:4rem; align-items:center; justify-content:center; background:#47474780; border-radius:.5rem; }
  .small-logo img { width:1.6875rem; height:3rem; }
  .menu-panel { background:#303030; color:#fff; border-radius:1rem; padding:2.5rem; display:grid; gap:2.5rem; margin:1rem var(--page-gutter) 0; pointer-events:auto; }
  [data-ready] .menu-panel { position:absolute; right:var(--page-gutter); top:calc(var(--header-padding) + 5rem); width:min(37.5rem,calc(100% - 2 * var(--page-gutter))); max-height:calc(100dvh - var(--header-padding) - 6rem); overflow-y:auto; overscroll-behavior:contain; margin:0; }
  .menu-close { position:absolute; top:1rem; right:1rem; width:3rem; height:3rem; background:#474747; }
  .menu-close img { filter:brightness(0) invert(1); }
  nav ul { list-style:none; margin:0; padding:0 3rem 0 0; display:grid; gap:1rem; }
  nav a { font:900 2.5rem/3rem var(--font-family-primary); text-decoration:none; }
  nav a:hover { color:var(--color-text-accent); }
  .menu-contact h2 { font:300 2rem/3rem var(--font-family-secondary); text-transform:none; margin-bottom:.5rem; }
  .menu-contact p { font-size:1.25rem; line-height:2.25rem; overflow-wrap:anywhere; }
  .eyebrow { margin-bottom:1.5rem; }
  @media(max-width:39.99rem) { .full-logo { display:none; } .small-logo { display:flex; } .logo-link { width:3rem; } .menu-panel { padding:1.5rem; gap:2rem; } nav a { font-size:1.75rem; line-height:2.5rem; } .menu-contact p { font-size:1rem; line-height:1.5rem; } }
</style>
