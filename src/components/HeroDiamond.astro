<div class="hero-diamond" data-diamond aria-hidden="true">
  <picture class="diamond-top"
    ><source
      media="(max-width: 639.84px)"
      srcset="/assets/hero/diamond-top-small.png"
    /><img
      src="/assets/hero/diamond-top-large.png"
      width="719"
      height="636"
      alt=""
    /></picture
  >
  <picture class="diamond-bottom"
    ><source
      media="(max-width: 639.84px)"
      srcset="/assets/hero/diamond-bottom-small.png"
    /><img
      src="/assets/hero/diamond-bottom-large.png"
      width="788"
      height="846"
      alt=""
    /></picture
  >
  <span class="viewport-measure"></span>
</div>
<script>
  const diamond = document.querySelector<HTMLElement>('[data-diamond]');
  if (diamond) {
    const measure = diamond.querySelector<HTMLElement>('.viewport-measure')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let range = 1,
      travel = 0,
      frame = 0;
    const update = () => {
      frame = 0;
      const p = reduced.matches ? 0 : Math.min(1, Math.max(0, scrollY / range));
      diamond.style.setProperty('--diamond-travel', `${p * travel - 4}px`);
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    const resize = () => {
      range = measure.getBoundingClientRect().height || 1;
      // Current layer delta / width: Large 156/393.7959, Small 124/276.4774.
      const ratio = parseFloat(
        getComputedStyle(diamond).getPropertyValue('--travel-ratio'),
      );
      travel = diamond.getBoundingClientRect().width * ratio;
      schedule();
    };
    const observer = new ResizeObserver(resize);
    observer.observe(diamond);
    observer.observe(measure);
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', resize);
    window.addEventListener('pageshow', resize);
    reduced.addEventListener('change', resize);
    resize();
    window.addEventListener('pagehide', () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
    });
  }
</script>
<style>
  .hero-diamond {
    --travel-ratio: 1;
    --diamond-travel: 0px;
    width: 276.477px;
    max-width: 100%;
    aspect-ratio: 276.4774/445.7738;
    position: relative;
    pointer-events: none;
  }
  picture {
    display: block;
    position: absolute;
  }
  picture img {
    width: 100%;
    height: 100%;
  }
  .diamond-top {
    top: -4%;
    left: 4.4143%;
    width: 91.1732%;
    height: 50.1%;
  }
  .diamond-bottom {
    width: 100%;
    height: 66.57%;
    top: 33.43%;
    transform: translateY(var(--diamond-travel));
  }
  .viewport-measure {
    position: absolute;
    visibility: hidden;
    width: 0;
    height: 100vh;
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .hero-diamond {
      width: 393.796px;
      aspect-ratio: 393.7959/634.3311;
      --travel-ratio: 0.39614433;
    }
    .diamond-bottom {
      top: 33.3709%;
      height: 66.6291%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .diamond-bottom {
      transform: translateY(-4px);
    }
  }
</style>
