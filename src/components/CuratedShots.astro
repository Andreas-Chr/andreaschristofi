---
import CuratedShotCard from './CuratedShotCard.astro';
import CuratedShotOverlay from './CuratedShotOverlay.astro';
import { curatedShots } from '../data/curated-shots';
---
{curatedShots.length > 0 && <>
  <section id="curated-shots" class="section container curated-shots" aria-label="Curated shots">
    <div class="curated-grid">{curatedShots.map(shot => <CuratedShotCard shot={shot} layout="caption" />)}</div>
    <noscript><p>Enable JavaScript to open curated shots.</p></noscript>
  </section>
  <CuratedShotOverlay shots={curatedShots} />
</>}
<style>
  .curated-shots { padding-block:160px; }
  .curated-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); align-items:start; gap:32px 4px; }
  /* Two 304px cards plus the gap and compact page gutters need 644px. */
  @media(max-width:643px) { .curated-grid { grid-template-columns:minmax(0,1fr); } }
</style>
