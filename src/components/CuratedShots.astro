---
import CuratedShotCard from './CuratedShotCard.astro';
import CuratedShotOverlay from './CuratedShotOverlay.astro';
import { curatedShots } from '../data/curated-shots';
---
{curatedShots.length > 0 && <>
  <section id="curated-shots" class="section container curated-shots" aria-labelledby="curated-shots-heading">
    <h2 id="curated-shots-heading">Curated shots</h2>
    <p class="curated-intro">A curated gallery of my latest interface designs, micro-interactions, and visual experiments. Think of these as bite-sized design concepts and daily UI exercises rather than full-scale case studies.</p>
    <div class="curated-grid">{curatedShots.map(shot => <CuratedShotCard shot={shot} layout="caption" sizes="(min-width: 1440px) 680px, (min-width: 1200px) calc((100vw - 80px) / 2), (min-width: 672px) calc((100vw - 64px) / 2), (min-width: 400px) calc(100vw - 32px), calc(100vw - 16px)" />)}</div>
    <noscript><p>Enable JavaScript to open curated shots.</p></noscript>
  </section>
  <CuratedShotOverlay shots={curatedShots} />
</>}
<style>
  .curated-shots { display:grid; gap:40px; padding-block:160px; }
  /* Figma 5734:2133: Display/Small, 40px from the H2 and from the grid. */
  .curated-intro { font:var(--text-display-small); font-variation-settings:'opsz' 14; }
  .curated-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); align-items:start; gap:32px; }
  /* Two 304px cards plus the gap and compact page gutters need 672px. */
  @media(max-width:671px) { .curated-grid { grid-template-columns:minmax(0,1fr); } }
</style>
