---
/** Figma: 02 - Components / Sticky Nav (5739:1738), Sticky Nav Dropdown (5744:1225)
 * and Sticky Nav Dropdown Item (5744:1146). A disclosure button whose label follows the
 * section in view; the dropdown lists every section. Disabled until the script runs.
 */
interface Props {
  links: { label: string; href: string }[];
  id?: string;
  class?: string;
}
const { links, id = 'sticky-nav', class: className } = Astro.props;
const icon = (name: string) => ['default', 'hover', 'disabled'].map(state => ({
  state, src: `/assets/icons/sticky-nav-${name}${state === 'default' ? '' : `-${state}`}.svg`,
}));
---
<nav class:list={['sticky-nav', className]} aria-label="On this page" data-sticky-nav data-open="false">
  <button class="sticky-nav-bar" type="button" aria-expanded="false" aria-controls={`${id}-menu`} disabled>
    <span class="sticky-nav-icon sticky-nav-burger" aria-hidden="true">
      {icon('burger').map(({ state, src }) => <img class={`icon-${state}`} src={src} width="24" height="24" alt="" />)}
    </span>
    <span class="sr-only">On this page:</span>
    <span class="sticky-nav-current" data-sticky-nav-current>{links[0]?.label}</span>
    <span class="sticky-nav-icon sticky-nav-chevron" aria-hidden="true">
      {icon('chevron').map(({ state, src }) => <img class={`icon-${state}`} src={src} width="16" height="9" alt="" />)}
    </span>
  </button>
  <ul class="sticky-nav-menu" id={`${id}-menu`}>
    {links.map(link => <li><a class="sticky-nav-item" href={link.href}>{link.label}</a></li>)}
  </ul>
</nav>
<script>
  document.querySelectorAll<HTMLElement>('[data-sticky-nav]').forEach(nav => {
    if (nav.dataset.ready) return;
    const trigger = nav.querySelector<HTMLButtonElement>('.sticky-nav-bar')!;
    const current = nav.querySelector<HTMLElement>('[data-sticky-nav-current]')!;
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('.sticky-nav-item')];
    const targets = links.map(link => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    const setOpen = (open: boolean, restoreFocus = false) => {
      nav.dataset.open = String(open);
      trigger.setAttribute('aria-expanded', String(open));
      if (restoreFocus) trigger.focus({ preventScroll: true });
    };
    // The sticky ancestor keeps its place while the bar slides away, so it anchors both measurements below.
    let host: HTMLElement | null = nav;
    while (host && getComputedStyle(host).position !== 'sticky') host = host.parentElement;
    // The header row runs from the logo mark (start) to the menu button (end); the bar docks against them.
    const [start, end] = ['start', 'end'].map(edge => document.querySelector<HTMLElement>(`[data-header-edge='${edge}']`));
    const header = start?.closest('header');
    const headerBottom = () => header?.getBoundingClientRect().bottom ?? 0;
    // The bar names the last section whose top has scrolled under it, or under the header when the bar sits inside it.
    let active = -1;
    const update = () => {
      const line = Math.max((host ?? trigger).getBoundingClientRect().bottom, headerBottom()) + 48;
      let index = 0;
      targets.forEach((target, i) => { if (target && target.getBoundingClientRect().top <= line) index = i; });
      if (index === active) return;
      links[active]?.removeAttribute('aria-current');
      active = index;
      links[index].setAttribute('aria-current', 'location');
      current.textContent = links[index].textContent;
    };
    // Once the bar rises into the fixed header it lines up with the header row. Where it shares the row it fills
    // the space between the logo and menu button, 24px clear of each (9px and 19px at 480px and below);
    // stuck below the row it spans their outer edges.
    const narrow = matchMedia('(max-width: 480px)');
    let dockKey = '';
    const dock = () => {
      if (!host || !start || !end) return;
      const box = host.getBoundingClientRect(), logo = start.getBoundingClientRect(), menu = end.getBoundingClientRect();
      if (!logo.width || !menu.width) return;
      const style = getComputedStyle(host), top = parseFloat(style.top);
      const beside = top < logo.bottom && top + box.height > logo.top;
      const docked = box.top < headerBottom();
      const [gapStart, gapEnd] = narrow.matches ? [9, 19] : [24, 24];
      const inset = [
        (beside ? logo.right + gapStart : logo.left) - box.left - parseFloat(style.paddingLeft),
        box.right - parseFloat(style.paddingRight) - (beside ? menu.left - gapEnd : menu.right),
      ];
      const key = `${docked}|${inset}`;
      if (key !== dockKey) {
        dockKey = key;
        nav.style.setProperty('--sticky-nav-dock-start', `${inset[0]}px`);
        nav.style.setProperty('--sticky-nav-dock-end', `${inset[1]}px`);
        nav.dataset.docked = String(docked);
      }
      // While the bar shares the row, the header keeps its wordmark and Menu label out of the bar's space.
      document.documentElement.toggleAttribute('data-sticky-nav-docked', docked && beside);
    };
    let frame = 0;
    const schedule = () => { frame ||= requestAnimationFrame(() => { frame = 0; update(); dock(); }); };
    trigger.addEventListener('click', () => setOpen(nav.dataset.open !== 'true'));
    links.forEach(link => link.addEventListener('click', () => setOpen(false)));
    nav.addEventListener('focusout', event => { const next = event.relatedTarget as Node | null; if (next && !nav.contains(next)) setOpen(false); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && nav.dataset.open === 'true') setOpen(false, nav.contains(document.activeElement)); });
    document.addEventListener('click', event => { if (nav.dataset.open === 'true' && !nav.contains(event.target as Node)) setOpen(false); });
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    if (links.length) update();
    // A page restored mid-scroll starts docked rather than animating into place.
    nav.style.transition = 'none';
    dock();
    nav.getBoundingClientRect();
    nav.style.transition = '';
    trigger.disabled = false;
    nav.dataset.ready = 'true';
  });
</script>
<style>
  /* The bar is 50px tall (1px border and 8px padding around a 32px line). The page sets where it sticks
     (--sticky-nav-top) and how far anchors land below it. */
  /* The bar stays in view while scrolling either way. */
  .sticky-nav { position:relative; transition:margin var(--primitive-animation-duration-standard) var(--primitive-animation-easing-standard); }
  /* Docked in the header (see script): the margins pull the bar from its column to the header row's elements. */
  .sticky-nav[data-docked='true'] { margin-inline:var(--sticky-nav-dock-start,0px) var(--sticky-nav-dock-end,0px); }
  /* Figma “lumi card strong” glass, shared by bar and dropdown: Color/Neutral/700 at 60% with a white 12% border,
     a 40px background blur (CSS blur(20px)) and the shared soft shadow. */
  .sticky-nav-bar,.sticky-nav-menu { border:1px solid rgb(255 255 255 / 12%); border-radius:16px; background:var(--color-surface-card-dark-glass); -webkit-backdrop-filter:blur(20px); backdrop-filter:blur(20px); box-shadow:0 2px 10px 0 #00000012; }
  /* Figma uses 24px gap on Desktop Default only; 16px everywhere else keeps the label still on hover. */
  .sticky-nav-bar { display:flex; align-items:center; gap:16px; width:100%; padding:8px 24px; border-radius:999px; color:var(--color-text-light); text-align:left; transition:background var(--primitive-animation-duration-fast) var(--primitive-animation-easing-fast),color var(--primitive-animation-duration-fast) var(--primitive-animation-easing-fast); }
  .sticky-nav-icon { display:grid; flex-shrink:0; }
  .sticky-nav-icon img { grid-area:1 / 1; }
  .sticky-nav-burger img { width:24px; height:24px; }
  .sticky-nav-chevron { transition:transform var(--primitive-animation-duration-standard) var(--primitive-animation-easing-standard); }
  .sticky-nav-chevron img { width:16px; height:9px; }
  .icon-hover,.icon-disabled { visibility:hidden; }
  .sticky-nav-current { flex:1; min-width:0; overflow:hidden; font:var(--text-body-medium); font-variation-settings:'opsz' 9; white-space:nowrap; text-overflow:ellipsis; }
  /* State=Hover (5739:1739): Color/Neutral/600, at the glass's 60%; the open bar keeps it and flips the chevron. */
  .sticky-nav-bar[aria-expanded='true'] { background:rgb(71 71 71 / 60%); color:var(--color-text-accent); }
  .sticky-nav-bar[aria-expanded='true'] .icon-default { visibility:hidden; }
  .sticky-nav-bar[aria-expanded='true'] .icon-hover { visibility:visible; }
  .sticky-nav-bar[aria-expanded='true'] .sticky-nav-chevron { transform:rotate(180deg); }
  @media(hover:hover) {
    .sticky-nav-bar:not(:disabled):hover { background:rgb(71 71 71 / 60%); color:var(--color-text-accent); }
    .sticky-nav-bar:not(:disabled):hover .icon-default { visibility:hidden; }
    .sticky-nav-bar:not(:disabled):hover .icon-hover { visibility:visible; }
  }
  /* State=Disabled (5739:1748): shown only until the script enables the bar. */
  .sticky-nav-bar:disabled { background:rgb(71 71 71 / 60%); color:var(--color-button-disabled); }
  .sticky-nav-bar:disabled .icon-default { visibility:hidden; }
  .sticky-nav-bar:disabled .icon-disabled { visibility:visible; }
  /* Sticky Nav Dropdown (5744:1225): 8px below the bar, same width and surface.
     Figma's 1px inside stroke leaves items 8px from the edge, hence 7px padding. */
  .sticky-nav-menu { position:absolute; top:calc(100% + 8px); left:0; right:0; display:flex; flex-direction:column; gap:4px; max-height:calc(100dvh - var(--sticky-nav-top,var(--header-clearance)) - 50px - 24px); margin:0; padding:7px; overflow-y:auto; overscroll-behavior:contain; list-style:none; opacity:0; visibility:hidden; transform:translateY(-8px); transition:opacity var(--primitive-animation-duration-fast) var(--primitive-animation-easing-fast),transform var(--primitive-animation-duration-fast) var(--primitive-animation-easing-fast),visibility 0s linear var(--primitive-animation-duration-fast); }
  [data-open='true'] .sticky-nav-menu { opacity:1; visibility:visible; transform:none; transition-delay:0s; }
  /* Sticky Nav Dropdown Item (5744:1146): hover lightens the row and switches to the accent. */
  .sticky-nav-item { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:8px 16px; border-radius:8px; color:var(--color-text-light); font:var(--text-body-medium); font-variation-settings:'opsz' 9; text-decoration:none; overflow-wrap:anywhere; transition:background var(--primitive-animation-duration-fast) var(--primitive-animation-easing-fast),color var(--primitive-animation-duration-fast) var(--primitive-animation-easing-fast); }
  /* State=Selected: the section in view keeps the accent and gains a dot at the row's end. */
  .sticky-nav-item[aria-current] { color:var(--color-text-accent); }
  .sticky-nav-item[aria-current]::after { content:''; flex-shrink:0; width:4px; height:4px; border-radius:50%; background:currentColor; }
  @media(hover:hover) { .sticky-nav-item:hover { background:rgb(255 255 255 / 12%); color:var(--color-text-accent); } }
  .sticky-nav-item:focus-visible { outline-offset:-3px; }
  /* Site/Header, Layout=Smallest: the bar shares the header row between the logo and menu button, so it drops the
     burger (it would sit beside the menu button's own) and tightens its padding to leave the label room. */
  @media(max-width:479px) {
    .sticky-nav-bar { padding-inline:16px; }
    .sticky-nav-burger { display:none; }
  }
</style>
