---
import SocialLinks from './SocialLinks.astro';
import { site } from '../data/site';
const phrases = ['Meaningful Experiences', 'Intuitive Products', 'Delightful Interactions'];
---
<footer class="site-footer">
  <div class="marquee"><div class="marquee-inner">{[0,1,2].map(copy=><div class="marquee-track" aria-hidden={copy ? 'true' : undefined}>{phrases.map(phrase=><span>{phrase}<i aria-hidden="true">/</i></span>)}</div>)}</div></div>
  <section class="footer-contact container" aria-labelledby="contact-heading">
    <h2 class="display" id="contact-heading">Let’s make<br />something <span>matter</span></h2>
    <div class="contact-disclosure" data-contact>
      <button class="contact-trigger" type="button" aria-label="Get in touch" aria-expanded="true" aria-controls="contact-panel" hidden><img src="/assets/icons/arrow-up-right.svg" width="80" height="80" alt="" /></button>
      <div class="contact-panel" id="contact-panel">
        <button class="icon-button contact-close" type="button" aria-label="Close contact details" hidden><img src="/assets/icons/close.svg" width="24" height="24" alt="" /></button>
        <p class="contact-title">Get in touch</p>
        <p>Submit a request to <a href={`mailto:${site.email}`}>{site.email}</a>. We’ll discuss your project and propose a solution.</p>
        <p class="eyebrow">Follow me</p><SocialLinks surface="light" menu compact />
      </div>
    </div>
  </section>
  <div class="footer-info container">
    <p class="copyright">© {new Date().getFullYear()} Andreas Christofi. All rights reserved.</p>
    <img class="footer-mark" src="/assets/logo/logo-light.svg" width="45" height="80" alt="" />
    <div class="footer-links"><a class="legal-link" href="/legal/">Privacy &amp; Cookie Policy</a><SocialLinks /></div>
  </div>
</footer>
<script>
  import { setPanel } from '../scripts/disclosure';
  document.querySelectorAll<HTMLElement>('[data-contact]').forEach(root => {
    if (root.dataset.ready) return;
    const trigger=root.querySelector<HTMLButtonElement>('.contact-trigger')!;
    const close=root.querySelector<HTMLButtonElement>('.contact-close')!;
    const panel=root.querySelector<HTMLElement>('.contact-panel')!;
    let open=false;
    const change=(next:boolean) => {
      open=next;
      panel.getAnimations().forEach(animation=>animation.cancel());
      trigger.getAnimations().forEach(animation=>animation.cancel());
      trigger.setAttribute('aria-expanded',String(open));
      root.dataset.open=String(open);
      trigger.hidden=open;
      panel.hidden=!open; panel.inert=!open;
      (open?close:trigger).focus({preventScroll:true});
      const entering=open?panel:trigger;
      if(!matchMedia('(prefers-reduced-motion: reduce)').matches && entering.animate) {
        const css=getComputedStyle(root);
        entering.animate([{opacity:0},{opacity:1}],{duration:240,easing:css.getPropertyValue('--primitive-animation-easing-standard').trim()});
      }
    };
    trigger.addEventListener('click',()=>change(true));
    close.addEventListener('click',()=>change(false));
    root.addEventListener('keydown',event=>{if(event.key==='Escape'&&open)change(false);});
    setPanel(panel,trigger,false,false); root.dataset.ready='true'; trigger.hidden=close.hidden=false;
  });
</script>
<style>
  .site-footer { padding-bottom:80px; max-width:1440px; margin-inline:auto; }
  .marquee { overflow:hidden; padding-block:40px; }
  .marquee-inner { display:flex; width:max-content; animation:marquee 32s linear infinite; }
  .marquee-track { display:flex; flex-shrink:0; }
  .marquee-track span { display:flex; align-items:center; gap:48px; padding-right:48px; white-space:nowrap; font:900 18px/24px var(--font-family-primary); text-transform:uppercase; }
  .marquee-track i { color:var(--color-text-accent); font-weight:400; }
  @keyframes marquee { to { transform:translateX(-33.333333%); } }
  .footer-contact { display:grid; gap:40px; align-items:center; padding-block:320px; }
  .footer-contact h2 { text-box-trim:trim-both; text-box-edge:cap alphabetic; font-size:32px; line-height:48px; }
  .footer-contact h2 span { color:var(--color-text-accent); }
  .contact-disclosure { min-width:0; }
  .contact-trigger { display:flex; align-items:center; justify-content:center; width:100%; padding:40px; border:0; border-radius:12px; background:var(--color-text-accent); }
  .contact-trigger img { width:48px; height:48px; }
  .contact-trigger:hover { background:var(--color-button-primary-hover); }
  .contact-trigger:hover img { filter:brightness(0) invert(1); }
  [data-open='true'] .contact-trigger { border-radius:12px 12px 0 0; }
  .contact-panel { padding:40px; position:relative; border-radius:12px; background:#fff; color:#303030; font-size:20px; line-height:36px; overflow-wrap:anywhere; }
  .contact-title { font-weight:300; font-size:32px; line-height:48px; margin:0 48px 16px 0; }
  .contact-close { position:absolute; right:16px; top:16px; width:48px; height:48px; background:#4b09f5; }
  .contact-close img { filter:brightness(0) invert(1); }
  .contact-panel .eyebrow { margin:80px 0 8px; color:#303030; }
  .footer-info { display:flex; flex-direction:column; align-items:center; gap:40px; text-align:center; }
  .copyright { order:3; }
  .footer-mark { order:1; width:45px; height:80px; }
  .footer-links { order:2; display:flex; flex-direction:column-reverse; align-items:center; gap:16px; }
  .legal-link { font-size:20px; line-height:36px; }
  @media(max-width:639px) { .contact-close { width:32px; height:32px; } .contact-close img { width:16px; height:16px; } .contact-panel { padding:16px; font-size:16px; line-height:32px; } .contact-panel .eyebrow { margin-top:40px; } }
  @media(min-width:400px) { .footer-contact { max-width:calc(448px + 2 * var(--page-gutter)); } .footer-contact h2 { font-size:48px; line-height:64px; } .contact-trigger img { width:64px; height:64px; } }
  @media(min-width:1024px) { .footer-contact { max-width:1440px; } .footer-contact h2 { text-box-trim:none; font-size:64px; line-height:72px; } .contact-trigger img { width:80px; height:80px; } }
  @media(min-width:1200px) { .footer-contact { grid-template-columns:minmax(0,1fr) minmax(0,1fr); } .footer-contact h2 { text-box-trim:none; font-size:64px; line-height:72px; } }

  @media(min-width:1024px) { .footer-info { flex-direction:row; text-align:left; gap:16px; } .copyright,.footer-links { flex:1; } .copyright { order:0; } .footer-links { flex-direction:row; justify-content:flex-end; } }
  @media(prefers-reduced-motion:reduce) { .marquee-inner { width:100%; } .marquee-track { width:100%; flex-wrap:wrap; justify-content:center; gap:16px; } .marquee-track span { white-space:normal; text-align:center; padding:0; } .marquee-track i,.marquee-track[aria-hidden] { display:none; } }
</style>
