---
import experience from '../data/experience.json';
---
<section class="experience" aria-labelledby="experience-heading" data-experience>
  <h2 id="experience-heading">Experience &amp; education</h2>
  <div class="experience-cards">
    {experience.map((entry,i)=><article class="experience-card">
      <h3><button class="experience-trigger" type="button" disabled aria-expanded="true" aria-controls={`experience-panel-${i}`}><span class="experience-title">{entry.title}</span><span class="experience-meta"><span>{entry.role}</span><span>{entry.year}</span></span><span class="experience-toggle" aria-hidden="true"><img class="plus" src="/assets/icons/plus.svg" width="16" height="16" alt="" /><img class="minus" src="/assets/icons/minus.svg" width="16" height="16" alt="" /></span></button></h3>
      <div class="experience-panel" id={`experience-panel-${i}`}>
        {entry.description.startsWith('- ') ? <ul>{entry.description.split('\n').map(line=><li>{line.replace(/^- /,'')}</li>)}</ul> : <p>{entry.description}</p>}
      </div>
    </article>)}
  </div>
</section>
<script>
  import { setPanel, resizeCards } from '../scripts/disclosure';
  document.querySelectorAll<HTMLElement>('[data-experience]').forEach(root=>{
    if(root.dataset.ready)return;
    const cards=Array.from(root.querySelectorAll<HTMLElement>('.experience-card'));
    let selected=0;
    const select=(index:number,animate=true)=>{
      selected=index;
      resizeCards(cards,()=>cards.forEach((card,i)=>{
        const trigger=card.querySelector<HTMLButtonElement>('button')!;
        const panel=card.querySelector<HTMLElement>('.experience-panel')!;
        const open=i===selected;
        card.dataset.open=String(open);
        setPanel(panel,trigger,open,open&&animate);
      }),animate);
    };
    cards.forEach((card,i)=>{
      const trigger=card.querySelector<HTMLButtonElement>('button')!;
      trigger.addEventListener('click',()=>{if(selected!==i)select(i);});
      trigger.disabled=false;
    });
    select(0,false);
    root.dataset.ready='true';
  });
</script>
<style>
  .experience { min-width:0; }
  h2 { margin-bottom:40px; }
  .experience-cards { display:grid; gap:4px; }
  .experience-card { position:relative; background:#fff; color:#303030; border-radius:8px; padding:24px; }
  .experience-trigger { display:block; width:100%; position:static; color:inherit; background:none; border:0; padding:0; text-align:left; }
  .experience-title { margin-bottom:8px; font-size:20px; line-height:36px; display:block; overflow-wrap:anywhere; }
  .experience-meta { font:400 12px/16px var(--font-family-primary); display:flex; flex-wrap:wrap; gap:8px 16px; }
  .experience-toggle { display:none; position:absolute; right:24px; top:50%; transform:translateY(-50%); width:40px; height:40px; border-radius:4px; background:#474747; align-items:center; justify-content:center; }
  .experience-toggle img { width:16px; height:16px; }
  .experience-panel { margin-top:24px; }
  .experience-panel ul { padding-left:20px; margin:0; }
  [data-ready] .experience-card[data-open='false'] { background:#303030; color:#fff; }
  [data-ready] .experience-card[data-open='false'] .experience-meta { color:#c5fa00; }
  [data-ready] .experience-toggle { display:flex; }
  [data-ready] .experience-trigger,[data-ready] .experience-panel { padding-right:64px; }
  [data-open='true'] .experience-toggle { background:#c5fa00; }
  [data-open='true'] .plus,[data-open='false'] .minus { display:none; }
  [data-open='false'] .plus { filter:brightness(0) invert(1); }
  .experience-card[data-open='true'] button:focus-visible { outline-color:#4b09f5; }
</style>
