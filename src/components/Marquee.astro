---
import { curatedShots } from '../data/curated-shots';
import { mediaURL } from '../lib/media-assets';
import { getImageProps, getOriginalImageURL } from '../lib/image-delivery';
import type { MarqueeThumbnail } from '../scripts/marquee';

/** Figma Marquee — 5723:2208. Plain text lines; each reveals its own marquee on hover. */
interface Props {
  items: { label: string }[];
}
const { items } = Astro.props;
const enabled = import.meta.env.IMAGE_TRANSFORMATIONS_ENABLED !== 'false';
// Sources are assigned client-side, so each page load picks its own thumbnails.
const pool = [...new Map(curatedShots.flatMap(shot => {
  const thumbnail = typeof shot.thumbnail === 'string' ? { url: shot.thumbnail } : shot.thumbnail;
  const url = mediaURL(thumbnail?.url);
  if (!url) return [];
  const asset = { ...thumbnail, url, alt: '' };
  const image = getImageProps(asset, { preset: 'card', sizes: '160px', enabled });
  const entry: MarqueeThumbnail = { src: image.src, srcset: image.srcset, sizes: image.sizes, original: getOriginalImageURL(asset) };
  return [[entry.src, entry] as const];
})).values()];
// Each half of the loop must stay wider than the 1440px container.
const groups = 4;
const copies = 6;
---
<div class="marquee" data-marquee data-marquee-pool={JSON.stringify(pool)}>
  <ul class="marquee-list" role="list">
    {items.map(item => (
      <li class="marquee-line">
        <div class="marquee-default">
          {Array.from({ length: copies }, (_, i) => <span class="marquee-text" aria-hidden={i ? 'true' : undefined}>{item.label}</span>)}
        </div>
        <div class="marquee-overlay" aria-hidden="true">
          <div class="marquee-overlay-inner">
            <div class="marquee-track">
              {/* Pills alternate between the line's two thumbnails, so each phrase sits between both. */}
              {Array.from({ length: groups }, (_, i) => <><span class="marquee-pill" data-pill={i % 2}><img alt="" decoding="async" /></span><span class="marquee-text">{item.label}</span></>)}
            </div>
          </div>
        </div>
      </li>
    ))}
  </ul>
</div>
<script>
  import { initMarquee } from '../scripts/marquee';
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach(initMarquee);
</script>
<style>
  .marquee { --marquee-loop-duration:15s; color:var(--color-text-light); font:900 var(--heading-size,32px)/var(--heading-line,48px) var(--font-family-primary); letter-spacing:0; text-transform:uppercase; font-feature-settings:'liga' 0; }
  .marquee-list { margin:0; padding:0; list-style:none; }
  /* clip, not hidden: a scroll container would capture the view() timeline. */
  .marquee-line { position:relative; overflow:clip; padding-block:24px; border-bottom:1px solid var(--color-border-subtle,#474747); }
  .marquee-line:first-child { border-top:1px solid var(--color-border-subtle,#474747); }
  .marquee-default { display:flex; justify-content:center; gap:16px; }
  .marquee-text { flex-shrink:0; white-space:nowrap; }
  .marquee-default > [aria-hidden] { display:none; }
  .marquee-overlay { position:absolute; inset:0; overflow:hidden; pointer-events:none; background:var(--primitive-color-neutral-white,#fff); color:var(--color-text-dark,#303030); transform:translateY(101%); }
  .marquee-overlay-inner { display:flex; align-items:center; height:100%; transform:translateY(-101%); }
  /* Per-item margins keep both halves identical, so the -50% loop is seamless. */
  .marquee-track { display:flex; align-items:center; width:max-content; animation:marquee-menu-loop var(--marquee-line-duration,var(--marquee-loop-duration)) linear infinite paused; }
  .marquee-track > * { flex-shrink:0; margin-inline-end:16px; }
  .marquee-track .marquee-text { font-weight:500; }
  .marquee-line[data-active] .marquee-track { animation-play-state:running; }
  .marquee-pill { display:block; width:2.5em; height:calc(63em / 64); border:1px solid var(--primitive-color-neutral-200,#e3e3e3); border-radius:var(--primitive-border-radius-pill,999px); overflow:hidden; background:#d9d9d9; }
  .marquee-pill img { display:block; width:100%; height:100%; object-fit:cover; visibility:hidden; }
  .marquee-pill img[data-loaded] { visibility:visible; }
  @keyframes marquee-menu-loop { to { transform:translateX(-50%); } }
  @keyframes marquee-menu-drift { from { transform:translateX(-35%); } to { transform:translateX(-15%); } }
  @keyframes marquee-menu-drift-reverse { from { transform:translateX(-15%); } to { transform:translateX(-35%); } }

  /* Without JavaScript, CSS reveals the overlay from below. */
  @media (hover:hover) {
    .marquee:not([data-ready]) .marquee-line:hover :is(.marquee-overlay,.marquee-overlay-inner) { transform:translateY(0); }
    .marquee:not([data-ready]) .marquee-line:hover .marquee-track { animation-play-state:running; }
  }
  @media (hover:hover) and (prefers-reduced-motion:no-preference) {
    .marquee:not([data-ready]) :is(.marquee-overlay,.marquee-overlay-inner) { transition:transform 600ms cubic-bezier(.16,1,.3,1); }
  }

  /* Touch screens have no hover state; the repeated text drifts with page scroll. */
  @media (hover:none) {
    .marquee-overlay { display:none; }
    .marquee-default { width:max-content; justify-content:flex-start; }
    .marquee-default > [aria-hidden] { display:block; }
  }
  @supports (animation-timeline: view()) {
    @media (hover:none) and (prefers-reduced-motion:no-preference) {
      .marquee-default { animation:marquee-menu-drift linear both; animation-timeline:view(); }
      .marquee-line:nth-child(even) .marquee-default { animation-name:marquee-menu-drift-reverse; }
    }
  }

  /* One still, readable copy; the only place a phrase may wrap. */
  @media (prefers-reduced-motion:reduce) {
    .marquee-track { animation:none; }
    .marquee-default { width:auto; justify-content:center; }
    .marquee-default > [aria-hidden] { display:none; }
    .marquee-default > .marquee-text { flex-shrink:1; min-width:0; white-space:normal; text-wrap:balance; overflow-wrap:anywhere; text-align:center; }
  }
</style>
