---
import { Picture } from 'astro:assets';
import heroBg from '../assets/hero-bg.jpg';
---
<!-- Figma hero_bg — 5709:5266. Lighten at 50% over the canvas. Place inside a page's .top-region. -->
<div class="hero-background" data-hero-background aria-hidden="true">
  <Picture class="hero-bg" src={heroBg} formats={['avif','webp']} fallbackFormat="jpg" widths={[768,1280,1920]} sizes="100vw" alt="" loading="eager" decoding="async" />
</div>
<style>
  /* Fills the top region and fades into the canvas at its boundary, as on every page. */
  .hero-background { position:absolute; inset:0; z-index:-1; pointer-events:none; overflow:hidden; background:var(--color-background-canvas); mask-image:linear-gradient(to bottom, #000 70%, transparent); }
  .hero-background :global(picture) { display:block; width:100%; height:100%; }
  .hero-bg { display:block; width:100%; height:100%; object-fit:cover; object-position:center top; mix-blend-mode:lighten; opacity:.5; }
  @media (forced-colors:active) { .hero-background { display:none; } }
</style>
