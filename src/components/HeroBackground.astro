<!-- Figma hero video — 5734:4924. Color dodge at 50% over the canvas. Homepage only; place inside its .top-region. -->
<div class="hero-background" data-hero-background aria-hidden="true">
  <video class="hero-video" muted loop playsinline disablepictureinpicture disableRemotePlayback preload="none" poster="/assets/hero/hero-bg-poster.webp" width="1920" height="1080">
    <source src="/assets/hero/hero-bg-1920.mp4" type="video/mp4" media="(min-width: 768px)" />
    <source src="/assets/hero/hero-bg-1280.mp4" type="video/mp4" />
  </video>
</div>
<script>
  import { initHeroVideo } from '../scripts/hero-video';
  document.querySelectorAll<HTMLElement>('[data-hero-background]').forEach(initHeroVideo);
</script>
<style>
  /* Fills the top region and fades into the canvas at its boundary. */
  .hero-background { position:absolute; inset:0; z-index:-1; pointer-events:none; overflow:hidden; background:var(--color-background-canvas); mask-image:linear-gradient(to bottom, #000 70%, transparent); }
  .hero-video { display:block; width:100%; height:100%; object-fit:cover; object-position:center top; mix-blend-mode:color-dodge; opacity:.5; }
