---
import ButtonMain from './ButtonMain.astro';
import ContactPopup from './ContactPopup.astro';
import { site } from '../data/site';
const words = ['Vision', 'Clarity', 'Systems', 'Hype'];
---
<section class="hero top-content container" aria-labelledby="hero-heading" data-hero>
  <div class="hero-copy">
    <h1 id="hero-heading" class="hero-headline">
      <span class="sr-only">Building vision, clarity, systems, hype.</span>
      <span aria-hidden="true" class="hero-static">Building</span>
      <span aria-hidden="true" class="hero-words">
        {words.map(word => <span class="hero-word">{word}</span>)}
      </span>
    </h1>
    <p class="hero-description">{site.heroDescription}</p>
    <div class="hero-actions">
      <ButtonMain href="#curated-shots">Explore Work</ButtonMain>
      <ButtonMain type="button" hierarchy="secondary" icon="/assets/icons/hero-arrow-up-right.svg" aria-haspopup="dialog" aria-controls="contact-popup" data-contact-popup-trigger>Book a Call</ButtonMain>
    </div>
  </div>
</section>
<ContactPopup />
<script>
  import { initHeroMotion } from '../scripts/hero-motion';
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach(initHeroMotion);
</script>
<script>
  // Kept apart from the GSAP-dependent motion module so Book a Call still works if that fails to load.
  document.querySelector<HTMLButtonElement>('[data-contact-popup-trigger]')?.addEventListener('click',()=>{
    const popup=document.getElementById('contact-popup');
    if(popup instanceof HTMLDialogElement && !popup.open) popup.showModal();
  });
</script>
<style>
  .hero { display:flex; align-items:center; justify-content:center; min-height:calc(100svh - var(--header-clearance)); padding-block:48px; }
  .hero-copy { position:relative; display:flex; flex-direction:column; align-items:center; width:100%; max-width:684px; gap:32px; text-align:center; }
  .hero-headline { width:100%; font:900 var(--heading-size)/var(--heading-line) var(--font-family-primary); text-transform:uppercase; }
  .hero-static { display:block; }
  .hero-words { display:grid; color:var(--color-text-accent); }
  .hero-word { grid-area:1 / 1; display:block; white-space:nowrap; opacity:0; }
  .hero-word:first-child { opacity:1; }
  /* Figma 5303:3411: a 600px measure wraps the copy onto two lines. */
  .hero-description { max-width:600px; font:var(--text-display-small); font-variation-settings:'opsz' 14; }
  .hero-actions { display:flex; align-items:center; justify-content:center; gap:16px; max-width:100%; }
  .hero-actions :global(.button) { white-space:nowrap; }
  .hero-actions :global([data-contact-popup-trigger] img) { width:14px; height:14px; flex:0 0 14px; }
  @media(min-width:400px) { .hero { padding-block:80px; } }
  @media(max-width:639px) { .hero-headline { line-height:calc(var(--heading-size) + 6px); } }
  @media(width < 479px) {
    .hero-actions { flex-direction:column; width:100%; }
    .hero-actions :global(.button) { width:100%; }
  }
  @media(max-width:399px) { .hero-description { font:var(--text-body-medium); } }
  @media(prefers-reduced-motion:reduce) { .hero-word { animation:none!important; transform:none; opacity:0; } .hero-word:first-child { opacity:1; } }
</style>
