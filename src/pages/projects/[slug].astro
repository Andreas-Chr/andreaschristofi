---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParagraphLink from '../../components/ParagraphLink.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import ToolBadge from '../../components/ToolBadge.astro';
import ProjectTiles from '../../components/ProjectTiles.astro';
import ProjectStory from '../../components/ProjectStory.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import StickyNav from '../../components/StickyNav.astro';
import { richTextHTML } from '../../lib/rich-text';
import { PROJECT_FALLBACK, isSearchHidden, projectAnchors, projectDescription, projectFacts, type CuratedProject } from '../../lib/curated-projects';

export async function getStaticPaths() {
  const { curatedProjects } = await import('../../data/curated-projects');
  return curatedProjects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
interface Props { project: CuratedProject; }
const { project } = Astro.props;
const anchors = projectAnchors(project);
const facts = projectFacts(project);
const summaryHTML = richTextHTML(project.summary);
const challenge = project.challenge;
const challengeHTML = richTextHTML(challenge?.body);
const stack = (project.stack ?? []).filter(item => item.tool);
const stackDetails = project.stackDetails;
const audienceTiles = (project.audience?.tiles ?? []).filter(tile => tile.title?.trim());
const hasChallenge = Boolean(challenge?.heading?.trim() || challenge?.eyebrow?.trim() || challengeHTML);
---
<BaseLayout title={`${project.title} — Andreas Christofi`} description={projectDescription(project)} searchHidden={isSearchHidden(project)}>
  <article class="project" aria-labelledby="project-title">
    <div class="top-region project-top-region">
      <!-- Figma project-overview_section (5603:862). -->
      <div class="project-overview container top-content">
        <div class="project-hero">
          <ParagraphLink mode="light" href="/#case-studies">← All Projects</ParagraphLink>
          <div class="project-hero-media">
            <ResponsiveImage asset={project.heroMedia} preset="hero" sizes="(min-width: 1440px) 1392px, (min-width: 1200px) calc(100vw - 48px), (min-width: 400px) calc(100vw - 32px), calc(100vw - 16px)" priority fallback={PROJECT_FALLBACK} />
          </div>
        </div>
        <h1 class="project-title" id="project-title">{project.title}</h1>
        {summaryHTML && <div class="project-rich project-summary" set:html={summaryHTML} />}
        {facts.length > 0 && (
          <dl class="project-facts">
            {facts.map(fact => <div><dt class="eyebrow">{fact.label}</dt><dd>{fact.value}</dd></div>)}
          </dl>
        )}
      </div>
    </div>
    <!-- Figma Sticky Nav (5739:1738): a direct child of the article so it stays stuck through every section. -->
    {anchors.links.length > 0 && <div class="project-toc container"><StickyNav links={anchors.links} /></div>}
    {(hasChallenge || stack.length > 0 || audienceTiles.length > 0) && (
      <div class="project-overview-body container">
        {(hasChallenge || stack.length > 0) && (
          <div class="project-challenge" id={anchors.overview}>
            {hasChallenge && (
              <section class="project-challenge-copy" aria-labelledby={challenge?.heading?.trim() ? 'project-challenge-heading' : undefined}>
                <div class="project-heading-group">
                  {challenge?.eyebrow?.trim() && <p class="eyebrow">{challenge.eyebrow}</p>}
                  {challenge?.heading?.trim() && <h2 class="project-heading" id="project-challenge-heading">{challenge.heading}</h2>}
                </div>
                {challengeHTML && <div class="project-rich project-challenge-body" set:html={challengeHTML} />}
              </section>
            )}
            {stack.length > 0 && (
              <section class="project-stack" aria-labelledby="project-stack-heading">
                <div class="project-heading-group">
                  {stackDetails?.eyebrow?.trim() && <p class="eyebrow">{stackDetails.eyebrow}</p>}
                  <h2 class="project-heading" id="project-stack-heading">{stackDetails?.heading?.trim() || 'Stack'}</h2>
                </div>
                {stackDetails?.intro?.trim() && <p class="project-stack-intro">{stackDetails.intro}</p>}
                <ul class="project-stack-badges">
                  {stack.map((item, index) => <ToolBadge tool={item.tool!} label={item.name} id={`project-tool-${index}`} />)}
                </ul>
              </section>
            )}
          </div>
        )}
        {audienceTiles.length > 0 && <ProjectTiles variant="audience" heading={project.audience?.heading} tiles={audienceTiles} headingId="project-audience-heading" />}
      </div>
    )}
    <!-- Figma media_section (5603:906): CMS-ordered tiles, two-column stages and visual cards. -->
    <div class="project-sections container">
      {(project.sections ?? []).map((section, index) => {
        const id = anchors.sections[index];
        const headingId = `project-section-${index + 1}-heading`;
        if (section.blockType === 'tiles') return <ProjectTiles variant={section.variant === 'phase' ? 'phase' : 'stat'} heading={section.heading} intro={section.intro} tiles={section.tiles} id={id} headingId={headingId} />;
        if (section.blockType === 'story') return <ProjectStory section={section} id={id} headingId={headingId} />;
        if (section.blockType === 'visual') return <ProjectVisual section={section} id={id} />;
        return null;
      })}
    </div>
  </article>
</BaseLayout>
<style>
  .project-top-region { height:auto; }
  .project-overview { display:flex; flex-direction:column; gap:80px; padding-top:40px; }
  .project-hero { display:flex; flex-direction:column; align-items:flex-start; gap:40px; }
  .project-hero-media { width:100%; aspect-ratio:1392 / 928; overflow:hidden; border-radius:var(--primitive-border-radius-24,24px); background:var(--color-surface-card-light); }
  .project-hero-media :global(img) { display:block; width:100%; height:100%; object-fit:cover; }
  .project-title { overflow-wrap:anywhere; }
  .project-summary { display:flex; flex-direction:column; gap:32px; }
  .project-facts { display:flex; flex-wrap:wrap; gap:32px 40px; margin:0; }
  .project-facts div { display:flex; flex-direction:column; gap:8px; }
  .project-facts dd { margin:0; font:var(--text-display-small); font-variation-settings:'opsz' 14; }
  /* Sticks below the fixed header (z 100) and opens over Go to top (z 50); the overview's 80px rhythm continues around it. */
  .project-toc { position:sticky; top:var(--header-clearance); z-index:60; margin-top:80px; }
  .project-overview-body { display:flex; flex-direction:column; gap:80px; padding-top:80px; }
  .project-challenge { display:grid; gap:80px 160px; align-items:start; }
  .project-challenge-copy { display:flex; flex-direction:column; gap:48px; min-width:0; }
  .project-heading-group { display:flex; flex-direction:column; gap:8px; }
  .project-challenge-body { display:flex; flex-direction:column; gap:24px; }
  .project-stack { display:flex; flex-direction:column; gap:32px; min-width:0; }
  .project-stack-intro { font:var(--text-display-small); font-variation-settings:'opsz' 14; }
  /* Badges wrap within the column the intro sets (Figma 518px) instead of widening it. */
  .project-stack-badges { display:flex; flex-wrap:wrap; gap:4px; width:0; min-width:100%; margin:0; padding:0; list-style:none; }
  .project-sections { display:flex; flex-direction:column; }
  /* Shared section typography: Headings/H3 for section titles and website text styles inside rich text. */
  .project :global(.project-heading) { font:var(--text-headings-h3); text-transform:uppercase; white-space:pre-line; overflow-wrap:break-word; }
  .project :global(.project-rich) { font:var(--text-body-medium); font-variation-settings:'opsz' 9; overflow-wrap:break-word; }
  .project :global(.project-rich :is(ul,ol)) { margin:0; padding-left:1.25em; }
  @media(min-width:1200px) {
    .project-challenge { grid-template-columns:minmax(0,1fr) auto; }
    .project-stack-intro { white-space:nowrap; }
  }
  @media(max-width:639px) {
    .project-overview,.project-overview-body { gap:48px; }
    .project-toc { margin-top:48px; }
    .project-overview-body { padding-top:48px; }
    .project-hero { gap:24px; }
    .project-hero-media { border-radius:16px; }
    .project-challenge { row-gap:48px; }
    .project-challenge-copy { gap:32px; }
    .project :global(.project-rich .text-display-medium) { font-size:24px; line-height:36px; }
  }
</style>
