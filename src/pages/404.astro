---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBackground from '../components/TopBackground.astro';
---
<BaseLayout title="Unknown Path — Andreas Christofi" description="This page could not be found. Return to Andreas Christofi’s homepage." noindex>
  <div class="top-region"><TopBackground /><section class="error-page top-content container" aria-labelledby="error-heading">
    <div class="error-copy"><p class="eyebrow">404 error</p><h1 id="error-heading">Unknown Path</h1><h2>Wrong coordinates</h2><p class="body-large">Lost your way? This route doesn’t exist anymore, but there are better paths ahead.</p><a class="button" href="/">Return Home<img src="/assets/icons/arrow-up-right.svg" width="24" height="24" alt="" /></a></div>
    <div class="error-visual"><picture><source media="(max-width: 399px)" srcset="/assets/icons/404-mobile.svg" /><source media="(max-width: 639px)" srcset="/assets/icons/404-narrow.svg" /><source media="(max-width: 899px)" srcset="/assets/icons/404-tablet.svg" /><source media="(max-width: 1199px)" srcset="/assets/icons/404-visual.svg" /><img class="error-art" src="/assets/icons/404-desktop.svg" width="685" height="550" alt="" aria-hidden="true" /></picture></div>
  </section></div>
</BaseLayout>
<style>
  .error-page { display:grid; align-items:center; gap:24px; padding-block:48px; overflow:hidden; }
  .error-copy { display:flex; flex-direction:column; align-items:flex-start; gap:24px; min-width:0; }
  .error-copy h2 { font-size:24px; line-height:36px; }
  .error-visual { display:flex; justify-content:center; align-items:center; min-width:0; height:359.36px; }
  .error-visual picture { display:block; flex-shrink:0; }
  .error-art { width:448px; height:359.36px; max-width:none; object-fit:contain; flex-shrink:0; }
  .error-copy .button img { width:14px; height:14px; }
  @media(max-width:399px) { .error-copy h1 { text-transform:uppercase; } .error-copy .button { width:100%; } }
  @media(min-width:640px) { .error-visual { height:720px; } .error-visual picture { display:flex; justify-content:center; width:100%; } .error-art { width:685px; max-width:100%; height:auto; max-height:720px; } }
  @media(min-width:900px) { .error-page { padding-block:80px; } .error-art { width:898px; } }
  @media(min-width:1200px) { .error-page { grid-template-columns:minmax(0,1fr) minmax(0,1fr); } .error-art { width:100%; } }
</style>
