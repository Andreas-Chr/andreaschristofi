---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBackground from '../components/TopBackground.astro';
import LegalText from '../components/LegalText.astro';
import copy from '../data/legal.json';
const slug=(text:string)=>text.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/-$/,'');
---
<BaseLayout title="Privacy & Cookie Policy — Andreas Christofi" description="How information is handled when you visit andreaschristofi.com, including privacy, cookies, infrastructure, and contact by email.">
  <div class="top-region legal-top-region">
    <TopBackground />
    <div class="legal-intro container top-content">
      <h1>{copy[0].text}</h1>
      <p class="eyebrow">
        Last updated:
        <time datetime="2026-08-31">31 August 2026</time>
      </p>
    </div>
  </div>
  <div class="legal-layout container">
    <article class="legal-copy" aria-label="Privacy and cookie policy">
      {copy.slice(2).map(item=>item.size===36||item.size===24?<h2 id={slug(item.text)}>{item.text}</h2>:item.size===18?<h3 id={slug(item.text)}>{item.text}</h3>:<LegalText text={item.text} size={item.size} segments={item.segments} />)}
    </article>
  </div>
</BaseLayout>
<style>
  .legal-top-region { height:auto; }
  .legal-intro { padding-block:80px 24px; display:grid; gap:24px; }
  .legal-intro h1 { overflow-wrap:anywhere; }
  .legal-layout { padding-bottom:80px; }
  .legal-copy { display:flex; flex-direction:column; gap:24px; font-size:16px; line-height:32px; min-width:0; }
  .legal-copy h2 { font-size:24px; line-height:36px; text-transform:uppercase; margin:0; overflow-wrap:break-word; }
  .legal-copy h2:first-of-type { font-size:36px; line-height:40px; }
  .legal-copy h3 { font:900 18px/24px var(--font-family-primary); margin:0; text-transform:uppercase; }
  @media(max-width:639px) { .legal-intro { padding-top:48px; } .legal-layout { padding-bottom:48px; } }
</style>
