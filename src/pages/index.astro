---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBackground from '../components/TopBackground.astro';
import HeroDiamond from '../components/HeroDiamond.astro';
import Process from '../components/Process.astro';
import Experience from '../components/Experience.astro';
import Tooltip from '../components/Tooltip.astro';
import allAwards from '../assets/all-awards.png';
import portrait from '../assets/andreas-bw.png';
import { site, toolGroups, awards } from '../data/site';
---
<BaseLayout title="Andreas Christofi — Digital Product Designer">
  <div class="top-region">
    <TopBackground />
    <section class="hero top-content container" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <h1 id="hero-heading">Designer<br />Researcher<br />Pathfinder</h1>
        <p class="lead">{site.description}</p>
        <a class="button" href={site.cv} download>
          Download CV
          <img src="/assets/icons/download.svg" width="24" height="24" alt="" />
        </a>
      </div>
      <div class="hero-visual">
        <HeroDiamond />
      </div>
    </section>
  </div>
  <Process />
  <section class="section about container" id="about" aria-labelledby="about-heading">
    <Picture class="portrait" src={portrait} formats={['avif','webp']} fallbackFormat="jpg" widths={[304,448,680,896,1120]} sizes="(min-width: 900px) 48vw, 100vw" alt="Andreas Christofi walking through the city" loading="lazy" />
    <div class="about-copy">
      <h2 id="about-heading">About me</h2>
      <p class="lead">{site.description}</p>
      <p class="body-large">For the past 2 decades, I’ve studied and worked across print, branding, web, and digital product design. I’ve learned the art of simplicity by crafting complex ideas into clear, impactful, and engaging experiences. And somewhere along the way, I’ve also had the opportunity to run my own studio, to lead creative teams, and work on SaaS digital products, and AI-powered tools.</p>
      <p class="body-large">Being a designer is only a part of who I am. I’m also a husband and father, a martial artist, an aviation geek and a custom PC builder. I make space in my life for the things I enjoy because they keep me curious, disciplined, grounded, and always eager to learn something new.</p>
      <div class="about-button">
        <a class="button secondary" href={site.cv} download>
          Download CV
          <img src="/assets/icons/download.svg" width="24" height="24" alt="" />
        </a>
      </div>
    </div>
  </section>
  <div class="section stack-experience container">
    <section class="stack" aria-labelledby="stack-heading">
      <h2 id="stack-heading">Stack</h2>
      <p class="body-large">Tools I’ve learned to design, prototype, animate and build cool projects with.</p>
      {toolGroups.map(group=><div class="tool-group"><h3 class="eyebrow">{group.label}</h3><ul>{group.tools.map(([label,slug])=><li class="tool" tabindex="0" aria-label={label} aria-describedby={`tool-${slug}-tooltip`} data-tooltip-owner><img class="tool-grey" src={`/assets/tools/${slug}-grey.svg`} width="32" height="32" alt="" aria-hidden="true" loading="lazy" /><img class="tool-color" src={`/assets/tools/${slug}-color.svg`} width="32" height="32" alt="" aria-hidden="true" loading="lazy" /><Tooltip id={`tool-${slug}-tooltip`} title={label} /></li>)}</ul></div>)}
    </section>
    <Experience />
  </div>
  <section class="section awards container" aria-labelledby="awards-heading">
    <h2 id="awards-heading">Awards</h2>
    <div class="awards-grid">
      <Picture class="certificates" src={allAwards} formats={['avif','webp']} fallbackFormat="png" widths={[304,448,684,992,1392]} sizes="(min-width: 1200px) 684px, calc(100vw - 32px)" alt="CSS Design Awards certificates for Innovation, Special Kudos, UI and UX" loading="lazy" />
      <ul class="award-list">
        {awards.map(award=><li><img src={`/assets/awards/${award.icon}.svg`} width="60" height="40" alt="" loading="lazy" /><div><h3>{award.title}</h3><p class="eyebrow">{award.detail}<span>{award.year}</span></p></div></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { height:100%; padding-block:48px; display:grid; gap:24px; align-items:center; max-width:1440px; }
  .hero-copy { display:flex; flex-direction:column; align-items:flex-start; gap:24px; padding-block:16px; position:relative; z-index:2; }
  .hero h1 { text-transform:uppercase; }
  .hero .lead { font-size:20px; line-height:36px; font-weight:500; }
  .hero-visual { position:absolute; inset:auto 0 0; display:flex; justify-content:center; z-index:0; }
  .hero-copy .button { width:100%; }
  .about { display:grid; gap:40px; align-items:start; }
  .about > :global(picture) { position:relative; width:100%; aspect-ratio:679/687; }
  .about :global(.portrait) { display:block; width:100%; height:100%; position:absolute; inset:0; aspect-ratio:679/687; object-fit:cover; object-position:bottom; border-radius:16px; }
  .about-copy { display:grid; gap:32px; min-width:0; }
  .about-button { padding-block:32px; }
  .stack-experience { display:grid; gap:80px 24px; align-items:start; }
  .stack h2 { margin-bottom:16px; }
  .tool-group { margin-top:40px; }
  .tool-group h3 { margin-bottom:16px; }
  .tool-group ul { display:flex; gap:4px; flex-wrap:wrap; list-style:none; padding:0; margin:0; }
  .tool { position:relative; display:flex; justify-content:center; align-items:center; width:80px; height:80px; background:#303030; border-radius:8px; }
  .tool img { transition:opacity var(--primitive-animation-duration-fast); width:24; height:24; }
  .tool:hover, .tool:focus-visible { background:#fff; }
  .tool:focus-visible { outline:3px solid var(--color-text-accent); outline-offset:2px; }
  .tool-color { opacity:0; overflow:clip; object-fit:contain; position:absolute; }
  .tool:is(:hover,:focus-visible) .tool-color { opacity:1; } .tool:is(:hover,:focus-visible) .tool-grey { opacity:0; }
  .awards h2 { margin-bottom:40px; }
  .awards-grid { display:grid; gap:40px 24px; align-items:start; }
  .award-list { display:grid; gap:4px; padding:0; margin:0; list-style:none; }
  .award-list li { display:flex; gap:24px; align-items:center; padding:24px; background:#303030; border-radius:8px; }
  .award-list li>img { width:60px; height:40px; object-fit:contain; flex-shrink:0; }
  .award-list h3 { font-size:20px; line-height:36px; margin-bottom:4px; }
  .award-list .eyebrow { display:flex; flex-wrap:wrap; gap:8px 16px; }
  @media(min-width:640px) {  .hero-copy { gap:48px; }  .hero-copy .button { width:auto; } .hero-visual { position:relative; opacity:1; padding:0; } }
  @media(min-width:900px) { .about { grid-template-columns:1fr 1fr; } }
  @media(min-width:400px) and (max-width:639.84px) { .hero { padding-block:80px; } .hero-copy { gap:48px; padding-block:48px; } .hero-copy .button { width:auto; } .hero-visual { bottom:80px; } }
  .certificates { display:block; width:100%; height:auto; }
  .hero .lead { max-width:683px; }
  @media(min-width:640px) and (max-width:1199px) { .hero { min-height:1376px; padding-block:96px 48px; align-content:space-between; } .hero-copy { padding:0; } .hero-visual { padding-bottom:0; } }
  @media(min-width:900px) and (max-width:1199px) { .hero { min-height:1288px; padding-block:128px 80px; gap:0; } }
  @media(min-width:1200px) {
    .hero { padding-block:80px; }
    .about .body-large { font-size:16px; line-height:32px; font-weight:400; }
    .about .lead { font-size:20px; line-height:36px; font-weight:500; }
    .hero { grid-template-columns:minmax(0,1fr) minmax(0,1fr); }

    .hero-visual { padding:0; }
    .stack-experience { grid-template-columns:1fr 1fr; }
    .awards-grid { grid-template-columns:1fr 1fr; }
  }
  @media(max-width:399.84px) { .hero .lead { font-size:16px; line-height:32px; font-weight:400; } .hero-visual { bottom:-41.77px; } .about-button .button { width:100%; } .stack-experience,.awards { padding-block:48px; } .award-list li { flex-direction:column; align-items:flex-start; gap:24px; padding:24px; } .award-list li>img { width:60px; height:38.86px; } }
  indesign { width:28; height:28; }
</style>
