{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "andreaschristofi",
  "account_id": "61467f1e98226d64c3eabb131e30f7bb",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "andreaschristofi.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
